{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "public/wasm/**",
    ".cache/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
