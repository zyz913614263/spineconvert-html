{
  "name": "spine-thing",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based Spine animation viewer, JSON/SKEL converter, and media exporter for Spine 3.3 through 4.2.",
  "keywords": [
    "animation-viewer",
    "json-converter",
    "skel-converter",
    "skeleton-animation",
    "spine",
    "spine-animation",
    "wasm",
    "webassembly",
    "webgl"
  ],
  "bugs": {
    "url": "https://github.com/cambacodes/spine-thing/issues"
  },
  "license": "MIT",
  "author": "Alejandro",
  "repository": {
    "type": "git",
    "url": "https://github.com/cambacodes/spine-thing.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings src tests scripts playwright.config.ts vite.config.ts",
    "format": "oxfmt --check src tests scripts index.html public/site.webmanifest package.json tsconfig.app.json tsconfig.json tsconfig.node.json playwright.config.ts vite.config.ts .oxlintrc.json .oxfmtrc.json",
    "format:write": "oxfmt --write src tests scripts index.html public/site.webmanifest package.json tsconfig.app.json tsconfig.json tsconfig.node.json playwright.config.ts vite.config.ts .oxlintrc.json .oxfmtrc.json",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run format && npm run lint && npm run test && npm run test:e2e",
    "build:converter": "node scripts/build-converter.mjs",
    "build:converter:update": "node scripts/build-converter.mjs --update"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@esotericsoftware/spine-webgl": "4.2.110",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.102.6",
    "@tanstack/react-virtual": "^3.14.10",
    "arktype": "^2.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.34.0",
    "mediabunny": "1.55.2",
    "modern-gif": "2.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.16.0"
}
